/**
 * Code Catcher — Gmail endpoint (runs inside YOUR Google account).
 *
 * It looks at mail received in the last few minutes, finds verification
 * codes, and returns ONLY the codes plus sender/subject/time as JSON.
 * Full email bodies never leave Google. Read-only access to Gmail.
 *
 * The access key below is generated by the extension. Anyone without it
 * gets "unauthorized". Don't share your web app URL or this key.
 */
const ACCESS_KEY = '__ACCESS_KEY__';

const VERSION = 1;
const DEFAULT_LOOKBACK_MINUTES = 30;
const MAX_MESSAGES = 15;

/* ------------------------------------------------------------------ */
/* Web app entry point                                                 */
/* ------------------------------------------------------------------ */

function doGet(e) {
  const p = (e && e.parameter) || {};
  if (ACCESS_KEY.length < 24 || p.key !== ACCESS_KEY) {
    return json_({ ok: false, error: 'unauthorized' });
  }
  try {
    const minutes = Math.min(Math.max(parseInt(p.minutes, 10) || DEFAULT_LOOKBACK_MINUTES, 1), 1440);
    return json_(getCodes_(minutes));
  } catch (err) {
    return json_({ ok: false, error: String((err && err.message) || err) });
  }
}

/** Optional: pick this in the Run menu to check that everything works. */
function testCodeCatcher() {
  const res = getCodes_(24 * 60);
  Logger.log('Inbox: ' + res.account);
  Logger.log('Codes found in the last 24h: ' + res.codes.length);
  res.codes.forEach(function (c) {
    Logger.log(c.code + '  —  ' + (c.fromName || c.fromEmail) + '  —  ' + c.subject);
  });
}

/* ------------------------------------------------------------------ */
/* Gmail                                                               */
/* ------------------------------------------------------------------ */

function getCodes_(minutes) {
  const now = Date.now();
  const after = Math.floor((now - minutes * 60000) / 1000);
  const res = Gmail.Users.Messages.list('me', {
    q: 'after:' + after + ' -in:sent -in:drafts',
    maxResults: MAX_MESSAGES,
    includeSpamTrash: true
  });
  const ids = ((res && res.messages) || []).map(function (m) { return m.id; });

  const cache = CacheService.getScriptCache();
  const cached = ids.length ? cache.getAll(ids.map(function (id) { return 'm' + VERSION + ':' + id; })) : {};
  const fresh = {};
  const codes = [];

  ids.forEach(function (id) {
    const key = 'm' + VERSION + ':' + id;
    let item = cached[key] ? JSON.parse(cached[key]) : null;
    if (!item) {
      try {
        item = analyzeMessage_(Gmail.Users.Messages.get('me', id, { format: 'full' }));
      } catch (err) {
        item = { id: id, code: null };
      }
      fresh[key] = JSON.stringify(item);
    }
    if (item.code) codes.push(item);
  });

  if (Object.keys(fresh).length) cache.putAll(fresh, 21600);
  codes.sort(function (a, b) { return b.receivedAt - a.receivedAt; });
  return { ok: true, version: VERSION, account: getAccount_(), now: now, codes: codes };
}

function getAccount_() {
  const cache = CacheService.getScriptCache();
  let acct = cache.get('account');
  if (!acct) {
    acct = Gmail.Users.getProfile('me').emailAddress;
    cache.put('account', acct, 21600);
  }
  return acct;
}

function analyzeMessage_(msg) {
  const payload = msg.payload || {};
  const headers = {};
  (payload.headers || []).forEach(function (h) { headers[String(h.name).toLowerCase()] = h.value; });

  const subject = headers['subject'] || '';
  const from = parseFrom_(headers['from'] || '');
  const bodies = { plain: [], html: [] };
  collectBodies_(payload, bodies);

  const sources = [
    bodies.plain.join('\n'),
    bodies.html.length ? htmlToText_(bodies.html.join('\n')) : '',
    msg.snippet ? decodeEntities_(msg.snippet) : ''
  ];

  let best = null;
  sources.forEach(function (text) {
    const found = extractCode_(subject, text);
    if (found && (!best || found.score > best.score)) best = found;
  });

  const isSms = /txt\.voice\.google\.com$/i.test(from.email);
  return {
    id: msg.id,
    code: best ? best.code : null,
    confidence: best ? best.confidence : null,
    context: best ? best.context : '',
    subject: truncate_(subject, 160),
    fromName: isSms ? 'Text from ' + (from.name || 'Google Voice') : from.name,
    fromEmail: from.email,
    sms: isSms,
    receivedAt: Number(msg.internalDate) || Date.now()
  };
}

function collectBodies_(part, bodies) {
  if (!part) return;
  if (part.parts && part.parts.length) {
    part.parts.forEach(function (p) { collectBodies_(p, bodies); });
    return;
  }
  if (part.filename) return; // attachment
  const data = part.body && part.body.data;
  if (!data) return;
  const type = String(part.mimeType || '').toLowerCase();
  if (type !== 'text/plain' && type !== 'text/html') return;
  const text = decodeBody_(data, part);
  if (type === 'text/plain') bodies.plain.push(text);
  else bodies.html.push(text);
}

function decodeBody_(data, part) {
  let bytes = data;
  if (typeof data === 'string') {
    let s = data;
    while (s.length % 4) s += '=';
    bytes = Utilities.base64DecodeWebSafe(s);
  }
  let charset = 'UTF-8';
  (part.headers || []).forEach(function (h) {
    if (String(h.name).toLowerCase() === 'content-type') {
      const m = /charset="?([^";\s]+)/i.exec(h.value || '');
      if (m) charset = m[1];
    }
  });
  try {
    return Utilities.newBlob(bytes).getDataAsString(charset);
  } catch (err) {
    return Utilities.newBlob(bytes).getDataAsString();
  }
}

function parseFrom_(raw) {
  const m = /^\s*"?([^"<]*?)"?\s*<([^>]+)>\s*$/.exec(raw);
  if (m) return { name: m[1].trim(), email: m[2].trim() };
  return { name: '', email: raw.trim() };
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function truncate_(s, n) {
  s = String(s || '');
  return s.length > n ? s.slice(0, n - 1) + '…' : s;
}

/* ------------------------------------------------------------------ */
/* Text helpers                                                        */
/* ------------------------------------------------------------------ */

function htmlToText_(html) {
  const text = String(html)
    .replace(/<(style|script|head|title)\b[^>]*>[\s\S]*?<\/\1>/gi, ' ')
    .replace(/<!--[\s\S]*?-->/g, ' ')
    .replace(/<br\s*\/?>/gi, '\n')
    .replace(/<\/(p|div|tr|li|h[1-6]|table|tbody|section|blockquote|center)>/gi, '\n')
    .replace(/<(p|div|tr|li|h[1-6]|table|section|blockquote|center)\b[^>]*>/gi, '\n')
    .replace(/<\/(td|th)>/gi, ' ')
    .replace(/<[^>]+>/g, '');
  return decodeEntities_(text);
}

function decodeEntities_(s) {
  const named = { nbsp: ' ', amp: '&', lt: '<', gt: '>', quot: '"', apos: "'", zwnj: '', zwj: '', shy: '', ensp: ' ', emsp: ' ', thinsp: ' ', ndash: '–', mdash: '—', copy: '©', reg: '®', hellip: '…', rsquo: '’', lsquo: '‘', rdquo: '”', ldquo: '“' };
  return String(s)
    .replace(/&#x([0-9a-f]+);/gi, function (_, h) { return safeChar_(parseInt(h, 16)); })
    .replace(/&#(\d+);/g, function (_, d) { return safeChar_(parseInt(d, 10)); })
    .replace(/&([a-z]+);/gi, function (m, n) { const v = named[n.toLowerCase()]; return v === undefined ? m : v; });
}

function safeChar_(code) {
  try { return String.fromCodePoint(code); } catch (e) { return ''; }
}

/* ------------------------------------------------------------------ */
/* Code extraction                                                     */
/* ------------------------------------------------------------------ */

// Words that signal a verification email. "code" alone counts unless it's a
// promo/zip/area/etc. code (see NOT_OTP_CODE).
const KEYWORD_RE = /\b(?:verification|verify|verifying|one[\s-]?time|otp|passcodes?|pass[\s-]code|security[\s-]code|log[\s-]?in|sign[\s-]?in|signing in|logging in|authenticat\w*|auth|2fa|mfa|two[\s-]?factor|2[\s-]?step|two[\s-]?step|confirm(?:ation)?[\s-]code|access[\s-]code|pin|codes?|token)\b/gi;
const NOT_OTP_CODE = /\b(?:promo(?:tional)?|promotion|discount|coupon|gift|voucher|offer|reward|referral|invite|invitation|zip|postal|post|area|country|source|bar|qr|dress|tracking|error|status|style|product|sort|swift|tax|redemption|sale)\s*$/i;

const STOPWORD_ALNUM = /^(?:COVID\d+|MP[34]|H26[45]|UTF8|SHA\d+|MD5|IPV[46]|B2[BC]|P2P|\d+K|\d+P|\d{1,2}(?:AM|PM|ST|ND|RD|TH|HR|HRS|MIN|MINS|GB|MB|TB|KB|PX|PT)|[A-Z]\d|\d[A-Z])$/;

/**
 * Finds the most likely verification code in an email.
 * Returns { code, score, confidence, context } or null.
 */
function extractCode_(subject, body) {
  const subj = normalize_(subject || '');
  const text = normalize_(body || '');
  const subjKw = keywordSpans_(subj);
  const bodyKw = keywordSpans_(text);
  if (!subjKw.length && !bodyKw.length) return null;

  const all = scoreCandidates_(subj, subjKw, true).concat(scoreCandidates_(text, bodyKw, false));
  if (!all.length) return null;

  // Merge identical codes (subject + body agreement is a strong signal).
  const byCode = {};
  all.forEach(function (c) {
    const prev = byCode[c.code];
    if (!prev) { byCode[c.code] = c; return; }
    const best = c.score > prev.score ? c : prev;
    byCode[c.code] = { code: best.code, score: best.score + (c.inSubject !== prev.inSubject ? 3 : 1), context: best.context, pos: Math.min(c.pos, prev.pos), inSubject: best.inSubject };
  });

  const ranked = Object.keys(byCode).map(function (k) { return byCode[k]; })
    .sort(function (a, b) { return b.score - a.score || a.pos - b.pos; });
  const top = ranked[0];
  if (top.score < 7) return null;
  return { code: top.code, score: top.score, confidence: top.score >= 10 ? 'high' : 'medium', context: top.context };
}

function normalize_(s) {
  return String(s)
    .replace(/\r\n?/g, '\n')
    .replace(/[​-‍⁠﻿͏­]/g, '')
    .replace(/\bhttps?:\/\/[^\s<>"')\]]+/gi, ' ')
    .replace(/\bwww\.[^\s<>"')\]]+/gi, ' ')
    .replace(/[\w.+-]+@[\w-]+(?:\.[\w-]+)+/g, ' ')
    .replace(/[ \t   ]+/g, ' ');
}

function keywordSpans_(text) {
  const spans = [];
  KEYWORD_RE.lastIndex = 0;
  let m;
  while ((m = KEYWORD_RE.exec(text))) {
    const word = m[0].toLowerCase();
    if (/^codes?$/.test(word) && NOT_OTP_CODE.test(text.slice(Math.max(0, m.index - 25), m.index))) continue;
    spans.push({ start: m.index, end: m.index + m[0].length, weak: /^(?:codes?|pin|token|auth)$/.test(word) });
  }
  return spans;
}

function scoreCandidates_(text, kw, inSubject) {
  const out = [];
  const taken = [];
  const patterns = [
    { re: /\d(?:[  ]\d){3,7}/g, base: 3, kind: 'spaced' },
    { re: /\d{3}[ -]\d{3}(?!\d)|\d{4}[ -]\d{4}(?!\d)/g, base: 4, kind: 'split' },
    { re: /\d{4,8}/g, base: 0, kind: 'num' },
    { re: /[A-Z0-9]{3,6}-[A-Z0-9]{3,6}|[A-Z0-9]{4,10}/g, base: 0, kind: 'alnum' }
  ];

  patterns.forEach(function (p) {
    p.re.lastIndex = 0;
    let m;
    while ((m = p.re.exec(text))) {
      const raw = m[0];
      const start = m.index;
      const end = start + raw.length;
      if (taken.some(function (t) { return start >= t[0] && end <= t[1]; })) continue;
      if (!boundaryOk_(text, start, end)) continue;

      let code = raw;
      let base = p.base;
      if (p.kind === 'spaced' || p.kind === 'split') {
        code = raw.replace(/[  -]/g, '');
        if (code.length < 6 && p.kind === 'split') continue;
      } else if (p.kind === 'num') {
        base = raw.length === 6 ? 5 : raw.length === 8 ? 3 : (raw.length === 4 || raw.length === 5 || raw.length === 7) ? 3 : 1;
      } else if (p.kind === 'alnum') {
        if (!/[A-Z]/.test(raw) || !/\d/.test(raw) || /^\d+$/.test(raw)) continue;
        if (STOPWORD_ALNUM.test(raw)) continue;
        base = raw.replace(/-/g, '').length >= 5 ? 3 : 2;
        if (/^[A-Z]{3,}-?\d{1,5}$/.test(raw)) base -= 3; // looks like WORD2026 / SAVE20 / ISO-8601
      }

      let score = base;
      const before = text.slice(Math.max(0, start - 40), start);
      const after = text.slice(end, end + 25);

      // Proximity to a verification keyword.
      let kwBonus = 0;
      let nearestBefore = Infinity;
      kw.forEach(function (k) {
        if (k.end <= start) {
          const d = start - k.end;
          nearestBefore = Math.min(nearestBefore, d);
          if (d <= 140) kwBonus = Math.max(kwBonus, Math.max(2, 6 - Math.floor(d / 30)) - (k.weak && d > 40 ? 1 : 0));
        } else if (k.start >= end) {
          const d = k.start - end;
          if (d <= 45) kwBonus = Math.max(kwBonus, 5 - Math.floor(d / 15));
        }
      });
      score += kwBonus;

      // Code on its own line, e.g. a big centered code in an HTML email.
      const lineStart = text.lastIndexOf('\n', start - 1) + 1;
      let lineEnd = text.indexOf('\n', end);
      if (lineEnd < 0) lineEnd = text.length;
      const line = text.slice(lineStart, lineEnd).trim();
      if (!inSubject && line === raw) score += 4;
      if (inSubject) score += 2;

      if (/(?:\bis|:)\s*$/i.test(before)) score += 1;
      if (/^G-$/.test(text.slice(start - 2, start))) score += 1;

      // Things that are numbers but not codes.
      if (raw.length === 4 && /^(?:19|20)\d\d$/.test(raw)) score -= nearestBefore <= 15 ? 1 : 6;
      if (/(?:order|account|acct|phone|case|reference|ref|ticket|tracking|confirmation|invoice|member|customer|policy|routing|card|booking|reservation|transaction|receipt)\s*(?:number|no\.?|num|#|id)?\s*[:#]?\s*$/i.test(before)) score -= 6;
      if (/\b(?:id|ip|ref)\s*[:#]?\s*$/i.test(before)) score -= 6;
      if (/(?:ending(?: in)?|last (?:4|four)(?: digits)?|ext\.?|extension|x|suite|ste\.?|unit|apt\.?|floor|box|version|v\.?|build|©|copyright|call(?: us)?(?: at)?|text|dial|tel\.?|fax)\s*[:#]?\s*$/i.test(before)) score -= 6;
      if (/\(\d{2,4}\)\s?$/.test(before)) score -= 8;
      if (/^\s*(?:minutes?|mins?|hours?|hrs?|seconds?|secs?|days?|%|px|pt|am|pm|usd|dollars|points|items?)\b/i.test(after)) score -= 8;
      if (/\b(?:st|street|ave|avenue|road|rd|blvd|drive|dr|lane|ln|way|parkway|pkwy|suite|ste|floor|p\.?o\.? box)\b\.?,?/i.test(line) && /\b[A-Z]{2}\s+\d{5}\b|\d{5}(?:-\d{4})?\s*$/.test(line)) score -= 6;
      if (/\b[A-Z]{2},?\s+$/.test(before) && raw.length === 5) score -= 5; // "CA 94043"

      taken.push([start, end]);
      out.push({
        code: code,
        score: score,
        pos: start,
        inSubject: inSubject,
        context: text.slice(Math.max(0, start - 50), Math.min(text.length, end + 30)).replace(/\s+/g, ' ').trim()
      });
    }
  });
  return out;
}

function boundaryOk_(text, start, end) {
  const prev = text.charAt(start - 1);
  const prev2 = text.charAt(start - 2);
  const next = text.charAt(end);
  const next2 = text.charAt(end + 1);

  if (/[A-Za-z0-9_*]/.test(prev)) return false;
  if (prev === '-') {
    // Allow Google-style "G-123456", reject phone numbers / ids like 555-1234.
    if (!(/[A-Z]/.test(prev2) && !/[A-Za-z0-9]/.test(text.charAt(start - 3)))) return false;
  }
  if (/[\/+$#€£¥@=&~]/.test(prev)) return false;
  if ((prev === '.' || prev === ',' || prev === ':') && /\d/.test(prev2)) return false;

  if (/[A-Za-z0-9_%@\/]/.test(next)) return false;
  if (next === '-' && /[A-Za-z0-9]/.test(next2)) return false;
  if ((next === '.' || next === ',' || next === ':') && /\d/.test(next2)) return false;
  return true;
}

// Lets the same file be unit-tested in Node. Ignored by Apps Script.
if (typeof module !== 'undefined') {
  module.exports = { extractCode_: extractCode_, htmlToText_: htmlToText_, analyzeMessage_: analyzeMessage_, doGet: doGet };
}
